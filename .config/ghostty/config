# theme
theme = Catppuccin Mocha

# window
quit-after-last-window-closed = true
window-decoration = client
window-width = 120
window-height = 36
window-padding-color = extend
window-padding-y = 0
window-padding-x = 8
window-padding-balance = true
window-subtitle = false
window-save-state = always
window-step-resize = true
resize-overlay = always

# macos
macos-titlebar-style = hidden
macos-titlebar-proxy-icon = hidden
macos-window-buttons = hidden
macos-option-as-alt = true
macos-icon = glass
# macos-auto-secure-input = true
# macos-secure-input-indication = false

# background
background-blur-radius = 40
background-opacity = 0.95
background-blur = true

# font
font-family = "Monaspace Neon Var"
font-style = "Regular"
font-style-bold = "Bold"
font-family-italic = "Monaspace Radon Var"
font-style-italic = "Medium Italic"
font-family-bold-italic = "Monaspace Radon Var"
font-style-bold-italic = "Bold Italic"
font-size = 15
font-feature = +liga
window-title-font-family = "Monaspace Neon Var"

# cursor
cursor-color = #cdd6f4
cursor-style = underline
adjust-cursor-thickness = 5
adjust-cursor-height = -2
adjust-underline-position = 4
adjust-underline-thickness = 1
adjust-strikethrough-position = 0
adjust-strikethrough-thickness = 1
shell-integration-features = no-cursor

# selection
selection-background = #cdd6f4
selection-foreground = #1e1e2e
selection-invert-fg-bg = true

# input
mouse-hide-while-typing = true
mouse-scroll-multiplier = 2
tab-inherit-working-directory = false

# updates
auto-update = check
auto-update-channel = tip

