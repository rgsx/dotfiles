{
  "[html]": {
    "editor.rulers": [120],
    "editor.wordWrap": "on",
    "editor.defaultFormatter": "vscode.html-language-features",
  },
  "[scss]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "better-comments.tags": [
    {
      "tag": "!",
      "color": "#e78284",
      "strikethrough": false,
      "underline": false,
      "backgroundColor": "transparent",
      "bold": false,
      "italic": false,
    },
    {
      "tag": "?",
      "color": "#85c1dc",
      "strikethrough": false,
      "underline": false,
      "backgroundColor": "transparent",
      "bold": false,
      "italic": false,
    },
    {
      "tag": "",
      "color": "#626880",
      "strikethrough": false,
      "underline": false,
      "backgroundColor": "transparent",
      "bold": false,
      "italic": false,
    },
    {
      "tag": "//",
      "color": "#626880",
      "strikethrough": true,
      "underline": false,
      "backgroundColor": "transparent",
      "bold": false,
      "italic": false,
    },
    {
      "tag": "todo",
      "color": "#ef9f76",
      "strikethrough": false,
      "underline": false,
      "backgroundColor": "transparent",
      "bold": false,
      "italic": false,
    },
    {
      "tag": "*",
      "color": "#81c8be",
      "strikethrough": false,
      "underline": false,
      "backgroundColor": "transparent",
      "bold": false,
      "italic": false,
    },
  ],
  "catppuccin.accentColor": "lavender",
  "catppuccin.bracketMode": "rainbow",
  "catppuccin-icons.hidesExplorerArrows": true,
  "catppuccin-icons.specificFolders": true,
  "catppuccin-icons.monochrome": false,
  "catppuccin.italicKeywords": false,
  "catppuccin.workbenchMode": "default",
  "breadcrumbs.enabled": false,
  "breadcrumbs.filePath": "off",
  "cognitiveComplexity.showCodeLens": false,
  "cognitiveComplexity.showGutterIcon": false,
  "css.format.spaceAroundSelectorSeparator": true,
  "css.lint.fontFaceProperties": "error",
  "diffEditor.ignoreTrimWhitespace": true,
  "editor.autoIndent": "advanced",
  "editor.bracketPairColorization.enabled": true,
  "editor.foldingImportsByDefault": true,
  "editor.fontFamily": "MonaspiceNe Nerd Font",
  "editor.fontLigatures": true,
  "editor.fontSize": 13,
  "editor.fontWeight": "400",
  "editor.formatOnPaste": true,
  "editor.formatOnSave": true,
  "editor.formatOnType": true,
  "editor.letterSpacing": 0,
  "editor.lineHeight": 1.45,
  "editor.maxTokenizationLineLength": 20000,
  "editor.minimap.autohide": true,
  "editor.minimap.enabled": true,
  "editor.minimap.renderCharacters": false,
  "editor.minimap.size": "proportional",
  "editor.overviewRulerBorder": false,
  "editor.renderControlCharacters": false,
  "editor.renderLineHighlight": "all",
  "editor.renderWhitespace": "none",
  "editor.rulers": [80],
  "editor.scrollBeyondLastColumn": 1,
  "editor.scrollbar.horizontal": "hidden",
  "editor.scrollbar.horizontalScrollbarSize": 10,
  "editor.scrollbar.vertical": "hidden",
  "editor.scrollbar.verticalScrollbarSize": 10,
  "editor.semanticHighlighting.enabled": true,
  "editor.smoothScrolling": true,
  "editor.stickyScroll.enabled": false,
  "editor.stickyTabStops": true,
  "editor.tabSize": 4,
  "editor.wordWrap": "bounded",
  "editor.wordWrapColumn": 80,
  "editor.cursorStyle": "line",
  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorSurroundingLines": 8,

  "emmet.triggerExpansionOnTab": true,
  "errorLens.gutterIconsEnabled": true,
  "errorLens.margin": "4ch",

  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.decorations.colors": true,
  "explorer.incrementalNaming": "smart",
  "explorer.openEditors.sortOrder": "alphabetical",
  "explorer.sortOrder": "type",

  "files.autoSave": "off",
  "files.autoSaveDelay": 3000,
  "files.trimTrailingWhitespace": true,

  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "git.replaceTagsWhenPull": true,

  "html.format.wrapLineLength": 120,
  "json.schemaDownload.enable": true,
  "scm.diffDecorations": "gutter",
  "scss.lint.fontFaceProperties": "error",
  "scss.lint.unknownAtRules": "ignore",
  "workbench.agentsWindowButton.enabled": false,
  "workbench.editor.closeOnFileDelete": true,
  "workbench.editor.highlightModifiedTabs": true,
  "workbench.editor.openPositioning": "first",
  "workbench.editor.scrollToSwitchTabs": true,
  "workbench.editor.tabActionLocation": "left",
  "workbench.layoutControl.enabled": false,
  "workbench.list.mouseWheelScrollSensitivity": 2,
  "workbench.activityBar.location": "bottom",
  "workbench.fontAliasing": "auto",
  "workbench.panel.opensMaximized": "never",
  "workbench.list.smoothScrolling": true,
  "workbench.navigationControl.enabled": false,
  "workbench.quickOpen.closeOnFocusLost": true,
  "workbench.startupEditor": "none",
  "workbench.tree.expandMode": "singleClick",
  "workbench.tree.indent": 24,
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyle": "underline",
  "terminal.integrated.customGlyphs": true,
  "terminal.integrated.fontFamily": "MonaspiceNe Nerd Font Propo",
  "terminal.integrated.fontLigatures.enabled": true,
  "terminal.integrated.fontLigatures.featureSettings": "'calt' on, 'ss01' on, 'ss02' on, 'ss03' on, 'ss05' on, 'ss06' on, 'ss07' on, 'ss08' on, 'ss09' on, 'ss10' on, 'ss11' on, 'liga' on, 'cv01' 2, 'cv31' 1",
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "terminal.integrated.cursorStyleInactive": "none",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.fontWeight": 400,
  "terminal.integrated.fontWeightBold": 600,
  "terminal.integrated.gpuAcceleration": "on",
  "terminal.integrated.letterSpacing": 0,
  "terminal.integrated.lineHeight": 1.4,
  "terminal.integrated.minimumContrastRatio": 4.5,
  "terminal.integrated.mouseWheelScrollSensitivity": 10,
  "terminal.integrated.rescaleOverlappingGlyphs": true,
  "terminal.integrated.shellIntegration.decorationsEnabled": "gutter",
  "terminal.integrated.smoothScrolling": true,
  "terminal.integrated.unicodeVersion": "11",
  "problems.decorations.enabled": true,
  "problems.showCurrentInStatus": true,
  "window.autoDetectColorScheme": true,
  "window.commandCenter": false,
  "window.title": "${activeEditorShort}${separator}${rootName}",
  "window.restoreWindows": "all",
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },

  "less.lint.fontFaceProperties": "error",
  "workbench.productIconTheme": "icons-carbon",
  "workbench.iconTheme": "catppuccin-mocha",
  "gitlens.graph.changesColumn.enabled": true,
  "gitlens.graph.details.location": "auto",

  "breadcrumbs.symbolPath": "off",
  "scm.defaultViewMode": "tree",
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true,
    "**/.git": true,
    "**/coverage": true,
  },
  "zenMode.centerLayout": true,
  "zenMode.fullScreen": false,
  "zenMode.hideLineNumbers": false,
  "zenMode.restore": true,
  "security.workspace.trust.enabled": true,
  "security.workspace.trust.untrustedFiles": "open",
  "security.workspace.trust.startupPrompt": "never",
  "files.insertFinalNewline": true,
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
  },

  "explorer.confirmPasteNative": false,
  "explorer.compactFolders": true,
  "explorer.autoReveal": true,
  "terminal.integrated.defaultProfile.linux": "bash",
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.defaultProfile.windows": "PowerShell",

  "workbench.editor.showTabs": "multiple",
  "workbench.editor.tabSizing": "shrink",
  "workbench.editor.wrapTabs": false,
  "workbench.editor.pinnedTabsOnSeparateRow": true,
  "workbench.editor.labelFormat": "short",
  "workbench.editor.enablePreview": false,
  "workbench.editor.enablePreviewFromQuickOpen": true,
  "workbench.editor.enablePreviewFromCodeNavigation": true,
  "workbench.tree.renderIndentGuides": "onHover",
  "workbench.tree.enableStickyScroll": false,
  "workbench.preferredDarkColorTheme": "The Great Sleeper",

  "editor.inlayHints.enabled": "offUnlessPressed",
  "editor.lightbulb.enabled": "off",
  "editor.codeLens": false,

  "editor.suggest.preview": true,
  "editor.suggestSelection": "first",
  "editor.acceptSuggestionOnCommitCharacter": false,
  "editor.tabCompletion": "on",
  "editor.quickSuggestions": {
    "other": true,
    "comments": false,
    "strings": false,
  },
  "editor.inlineSuggest.enabled": true,
  "editor.parameterHints.enabled": false,
  "editor.minimap.maxColumn": 80,
  "editor.glyphMargin": false,

  "editor.fastScrollSensitivity": 5,
  "editor.mouseWheelZoom": false,
  "security.workspace.trust.banner": "never",
}
