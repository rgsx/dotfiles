	},
	"gitlens.graph.minimap.enabled": false,
	"html.format.wrapLineLength": 0,
	"less.lint.fontFaceProperties": "error",
	"lifeline.battery.interval": 60000,
	"lifeline.clock.format": "H:mm",
	"lifeline.clock.interval": 60000,
