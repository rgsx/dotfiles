	"breadcrumbs.enabled": true,
	"breadcrumbs.filePath": "off",
	"css.format.spaceAroundSelectorSeparator": true,
	"css.lint.fontFaceProperties": "error",
	"diffEditor.ignoreTrimWhitespace": true,
	// "editor.defaultFormatter": "esbenp.prettier-vscode",
	"editor.fontFamily": "Monaspace Neon",
	"editor.fontLigatures": "'calt', 'ss01', 'ss02', 'ss03', 'ss05', 'ss06', 'ss07', 'ss08', 'ss09', 'ss10', 'ss11', 'liga', 'cv01' 2, 'cv31' 1",
	"editor.fontSize": 14,
	"editor.fontWeight": 400,
	"editor.formatOnPaste": true,
	"editor.formatOnSave": true,
	"editor.formatOnType": true,
	"editor.guides.bracketPairs": "active",
	"editor.guides.indentation": false,
	"editor.hideCursorInOverviewRuler": true,
	"editor.letterSpacing": 0,
	"editor.lineHeight": 0,
	"editor.linkedEditing": true,
	"editor.maxTokenizationLineLength": 20000,
	"editor.minimap.autohide": "mouseover",
	"editor.minimap.enabled": true,
	"editor.minimap.maxColumn": 80,
	"editor.minimap.renderCharacters": false,
	"editor.minimap.scale": 1,
	"editor.minimap.showSlider": "always",
	"editor.minimap.side": "right",
	"editor.minimap.size": "proportional",
	"editor.mouseWheelScrollSensitivity": 4,
	"editor.overviewRulerBorder": false,
	"editor.renderControlCharacters": false,
	"editor.renderLineHighlight": "all",
	"editor.renderWhitespace": "none",
	"editor.rulers": [
		80
	],
	"editor.scrollbar.horizontal": "hidden",
	"editor.scrollbar.horizontalScrollbarSize": 10,
	"editor.scrollbar.vertical": "hidden",
	"editor.scrollbar.verticalScrollbarSize": 10,
	"editor.scrollBeyondLastColumn": 1,
	"editor.semanticHighlighting.enabled": true,
	"editor.smoothScrolling": true,
	"editor.stickyScroll.enabled": false,
	"editor.stickyTabStops": true,
	"editor.tabSize": 4,
	"editor.wordWrap": "bounded",
	"editor.wordWrapColumn": 80,
	"emmet.triggerExpansionOnTab": true,
	//"errorLens.margin": "4ch",
	"explorer.confirmDelete": false,
	"explorer.confirmDragAndDrop": false,
	"explorer.incrementalNaming": "smart",
	"explorer.openEditors.sortOrder": "alphabetical",
	"explorer.sortOrder": "type",
	"files.autoSave": "afterDelay",
	"files.autoSaveDelay": 3000,
	"files.exclude": {
		"**/.DS_Store": true,
		"**/.git": true,
		"**/.hg": true,
		"**/.svn": true,
		"**/.yarn/cache": true,
		"**/CVS": true,
		"**/bower_components": true,
		"**/dist": true,
		"**/node_modules": true,
		"**/tmp": true,
		"**/.vscode": true,
		"**/.angular": true,
		"*.md": true
	},
	"files.trimTrailingWhitespace": true,
	"files.watcherExclude": {
		"**/.expo/**": true,
		"**/.git/objects/**": true,
		"**/.git/subtree-cache/**": true,
		"**/.yarn/cache/**": true,
		"**/bower_components/**": true,
		"**/dist/**": false,
		"**/node_modules/**": true,
		"**/tmp/**": true,
		"**/.angular/**": true
	},
	"git.autofetch": true,
	"git.confirmSync": false,
	"git.enableSmartCommit": true,
	"git.replaceTagsWhenPull": true,
	//"gitlens.advanced.messages": {
	//"suppressCreatePullRequestPrompt": true
	//},
	//"gitlens.graph.minimap.enabled": false,
	"html.format.wrapLineLength": 120,
	"json.schemaDownload.enable": true,
	"less.lint.fontFaceProperties": "error",
	//"path-intellisense.showHiddenFiles": true,
	//"prettier.useTabs": true,
	"problems.showCurrentInStatus": false,
	"scm.diffDecorations": "gutter",
	"scss.lint.fontFaceProperties": "error",
	"scss.lint.unknownAtRules": "ignore",
	//"sonarlint.disableTelemetry": true,
	//"sonarlint.focusOnNewCode": true,
	"terminal.integrated.cursorBlinking": true,
	"terminal.integrated.cursorStyle": "underline",
	"terminal.integrated.cursorStyleInactive": "none",
	"terminal.integrated.customGlyphs": true,
	"terminal.integrated.enableMultiLinePasteWarning": "never",
	"terminal.integrated.fontFamily": "MonaspiceNe Nerd Font Propo",
	"terminal.integrated.fontLigatures.enabled": true,
	"terminal.integrated.fontLigatures.featureSettings": "'calt' on, 'ss01' on, 'ss02' on, 'ss03' on, 'ss05' on, 'ss06' on, 'ss07' on, 'ss08' on, 'ss09' on, 'ss10' on, 'ss11' on, 'liga' on, 'cv01' 2, 'cv31' 1",
	"terminal.integrated.fontWeight": 400,
	"terminal.integrated.fontWeightBold": 600,
	"terminal.integrated.gpuAcceleration": "on",
	"terminal.integrated.letterSpacing": 0,
	"terminal.integrated.lineHeight": 0,
	"terminal.integrated.minimumContrastRatio": 1,
	"terminal.integrated.mouseWheelScrollSensitivity": 10,
	"terminal.integrated.rescaleOverlappingGlyphs": true,
	"terminal.integrated.shellIntegration.decorationsEnabled": "gutter",
	"terminal.integrated.smoothScrolling": true,
	"terminal.integrated.unicodeVersion": "11",
	"window.autoDetectColorScheme": true,
	"window.commandCenter": false,
	"workbench.activityBar.location": "top",
	"workbench.editor.centeredLayoutFixedWidth": true,
	"workbench.editor.closeOnFileDelete": true,
	"workbench.editor.editorActionsLocation": "hidden",
	"workbench.editor.enablePreview": false,
	"workbench.fontAliasing": "auto",
	"workbench.layoutControl.enabled": false,
	"workbench.list.mouseWheelScrollSensitivity": 4,
	"workbench.list.smoothScrolling": true,
	"workbench.navigationControl.enabled": false,
	"workbench.preferredDarkColorTheme": "Catppuccin Mocha",
	"workbench.preferredLightColorTheme": "Catppuccin Macchiato",
	"workbench.startupEditor": "none",
	"workbench.tree.expandMode": "singleClick",
	"workbench.tree.indent": 20,
	"zenMode.restore": false,
	"[html]": {
		"editor.rulers": [
			120
		],
		"editor.wordWrap": "on"
	}
}