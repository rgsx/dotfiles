## Pull completed VPS torrents to local Downloads with confirmation
vps-torrent-sync() {
  if [[ $# -lt 1 || $1 == -* ]]; then
    echo "Usage: vps-torrent-pull <local-destination> [--delete]" >&2
    return 1
  fi

  local dest="$1"
  local delete_after=0
  if [[ "${2:-}" == "--delete" ]]; then
    delete_after=1
  fi

  local remote_dir="/home/roberto/downloads/torrents/complete"
  local remote_list
  remote_list=$(ssh vps "find ${remote_dir} -mindepth 1 -maxdepth 1 -printf '%f\n' 2>/dev/null" 2>/dev/null)

  if [[ -z "$remote_list" ]]; then
    echo "No completed torrents found on VPS."
    return 0
  fi

  mkdir -p "$dest"
  echo "Syncing from: ${remote_dir}"
  echo "Syncing to  : ${dest}"
  echo
  echo "Files to download:"
  echo "$remote_list"
  echo
  echo "DRY RUN:"
  rsync -ahn --progress --ignore-existing -e ssh "vps:${remote_dir}/" "${dest}/"
  echo
  echo "Summary:"
  echo "$remote_list" | wc -l | tr -d ' ' | xargs -I{} echo "{} files queued."

  if [[ $delete_after -eq 1 ]]; then
    echo
    echo "This will DELETE the source files from the VPS after copy."
  fi

  echo
  read -q "REPLY?Continue with copy? [y/N]: "
  echo
  if [[ ! $REPLY =~ ^[Yy]$ ]]; then
    echo "Aborted."
    return 1
  fi

  rsync -avh --progress --ignore-existing -e ssh "vps:${remote_dir}/" "${dest}/"
  local rc=$?
  if [[ $rc -ne 0 ]]; then
    echo "rsync failed with exit code ${rc}" >&2
    return $rc
  fi

  echo
  echo "Verifying copied files..."
  local failed=0
  while IFS= read -r file; do
    [[ -z "$file" ]] && continue
    if [[ ! -f "${dest}/${file}" ]]; then
      echo "MISSING LOCAL : ${dest}/${file}" >&2
      failed=1
    else
      echo "OK LOCAL      : ${dest}/${file}"
    fi
  done <<< "$remote_list"

  if [[ $failed -ne 0 ]]; then
    echo "Verification failed; source files were NOT deleted." >&2
    return 1
  fi

  if [[ $delete_after -eq 1 ]]; then
    echo
    read -q "REPLY?Delete source files from VPS? [y/N]: "
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
      echo "Source files kept on VPS."
      return 0
    fi

    ssh vps "cd '${remote_dir}' && rm -f ${(f)remote_list}" || {
      echo "Remote delete failed; check VPS manually." >&2
      return 1
    }
    echo "Deleted source files from VPS."
  fi

  echo
  echo "Done."
  echo "Local  : ${dest}"
  echo "Remote : ${remote_dir}"
}

change-hostname() {
  local new_hostname="$1"
  if [[ -z "$new_hostname" ]]; then
    echo "Usage: change-hostname <new-hostname>" >&2
    return 1
  fi

  echo "Changing hostname to: $new_hostname"

  if [[ "$OSTYPE" == darwin* ]]; then
    sudo scutil --set HostName "$new_hostname"
    sudo scutil --set ComputerName "$new_hostname"
    sudo scutil --set LocalHostName "$new_hostname"
    dscacheutil -flushcache
    echo "Hostname updated on macOS."
  elif [[ "$OSTYPE" == linux-gnu* ]]; then
    sudo hostnamectl set-hostname "$new_hostname"
    echo "Hostname updated on Linux."
  else
    echo "Unsupported OS." >&2
    return 1
  fi
}

git-host() {
  local url host
  url=$(git config --get remote.origin.url 2>/dev/null || git ls-remote --get-url 2>/dev/null || true)
  [[ -z "$url" ]] && { echo "no remote"; return 1; }
  case "$url" in
    *://*) host="${url#*://}"; host="${host%%/*}" ;;
    *)     host="${url%%:*}" ;;
  esac
  host="${host#*@}"
  print -r -- "$host"
}

woff2otf() {
  emulate -L zsh
  setopt extended_glob no_unset

  local -a o_out o_force o_dry o_rec o_help
  zparseopts -D -E -F -- o:=o_out f=o_force n=o_dry r=o_rec h=o_help -help=o_help || return 2

  if (( $#o_help || $# == 0 )); then
    print -r -- "usage: woff2otf [-f] [-n] [-r] [-o DIR] FILE|DIR ...
  -o DIR  write .otf files to DIR (default: next to each input)
  -f      overwrite existing .otf files
  -n      dry run, only print what would be converted
  -r      search directories recursively"
    (( $#o_help )) && return 0 || return 2
  fi

  if (( ! $+commands[fontforge] )); then
    print -u2 "woff2otf: fontforge not found (macOS: brew install fontforge)"
    return 127
  fi

  local outdir=${${o_out[-1]:-}#-o}
  if [[ -n $outdir ]] && (( ! $#o_dry )); then
    mkdir -p -- "$outdir" || return 1
  fi

  local -a inputs
  local arg
  for arg in "$@"; do
    if [[ -d $arg ]]; then
      if (( $#o_rec )); then
        inputs+=( $arg/**/*.(#i)woff2(N.) )
      else
        inputs+=( $arg/*.(#i)woff2(N.) )
      fi
    elif [[ -f $arg ]]; then
      inputs+=( $arg )
    else
      print -u2 -r -- "woff2otf: not found: $arg"
    fi
  done

  if (( ! $#inputs )); then
    print -u2 "woff2otf: no .woff2 files to convert"
    return 1
  fi

  local in out tmp dir log
  local -a lines
  integer ok=0 skipped=0 failed=0
  for in in $inputs; do
    if [[ ${in:e:l} != woff2 ]]; then
      print -u2 -r -- "skip (not .woff2): $in"
      (( skipped++ )); continue
    fi

    dir=${outdir:-${in:h}}
    out=$dir/${in:t:r}.ttf

    if [[ -e $out ]] && (( ! $#o_force )); then
      print -u2 -r -- "skip (exists, use -f): $out"
      (( skipped++ )); continue
    fi

    if (( $#o_dry )); then
      print -r -- "$in -> $out"
      continue
    fi

    # Write to a temp file first so a failed run never leaves a broken .otf behind.
    tmp=$dir/.${in:t:r}.$$.otf
    log=$(fontforge -quiet -lang=ff -c 'Open($1); Generate($2); Close()' "$in" "$tmp" 2>&1)
    if (( $? == 0 )) && [[ -s $tmp ]] && mv -f -- "$tmp" "$out"; then
      print -r -- "ok: $out"
      (( ok++ ))
    else
      rm -f -- "$tmp"
      print -u2 -r -- "FAILED: $in"
      # Show FontForge's own error, minus its startup chatter.
      lines=( ${(f)log} )
      lines=( ${lines:#(PythonUI_Init*|copyUIMethodsToBaseTable*|Program root:*)} )
      (( $#lines )) && print -u2 -rl -- ${lines/#/    }
      (( failed++ ))
    fi
  done

  (( $#o_dry )) || print -r -- "done: $ok converted, $skipped skipped, $failed failed"
  (( failed == 0 ))
}

# Downmix 5.1 AC-3 files to stereo FLAC (24-bit) with one album-wide gain,
# so the loudest track peaks at the target and the balance between tracks is kept.
ac3tostereo() {
  emulate -L zsh
  setopt extended_glob no_unset

  local -a o_out o_force o_dry o_peak o_artist o_album o_year o_help
  zparseopts -D -E -F -- o:=o_out p:=o_peak a:=o_artist A:=o_album y:=o_year \
    f=o_force n=o_dry h=o_help -help=o_help || return 2

  if (( $#o_help || $# == 0 )); then
    print -r -- "usage: ac3tostereo [-f] [-n] [-p PEAK] [-o DIR] [-a ARTIST] [-A ALBUM] [-y YEAR] FILE|DIR ...
  -o DIR     write .flac files to DIR (default: FLAC/ next to each input)
  -p PEAK    target peak in dB for the loudest track (default: -1.0)
  -a/-A/-y   artist, album and year tags
  -f         overwrite existing .flac files
  -n         dry run, only measure and print the gain"
    (( $#o_help )) && return 0 || return 2
  fi
  (( $+commands[ffmpeg] )) || { print -u2 "ac3tostereo: ffmpeg not found (brew install ffmpeg)"; return 127; }

  local -a inputs; local arg
  for arg in "$@"; do
    if [[ -d $arg ]]; then inputs+=( $arg/*.(#i)ac3(N.) )
    elif [[ -f $arg ]]; then inputs+=( $arg )
    else print -u2 -r -- "ac3tostereo: not found: $arg"; fi
  done
  (( $#inputs )) || { print -u2 "ac3tostereo: no .ac3 files"; return 1; }

  # Pass 1: find the loudest peak of the decoder's stereo downmix across all files.
  typeset -F 1 target=${${o_peak[-1]:-}#-p} max=-200 p gain
  [[ -n ${o_peak[-1]:-} ]] || target=-1.0
  local in
  for in in $inputs; do
    p=$(ffmpeg -hide_banner -nostdin -downmix stereo -i "$in" -af volumedetect -f null - 2>&1 \
        | awk '/max_volume/ {print $5}')
    print -r -- "peak ${p} dB: ${in:t}"
    (( p > max )) && max=$p
  done
  (( gain = target - max ))
  print -r -- "album gain: ${gain} dB (loudest peak ${max} dB -> ${target} dB)"
  (( $#o_dry )) && return 0

  # Pass 2: encode with the shared gain.
  local outdir out title track n=0 ok=0 failed=0 total=$#inputs
  local -a tags
  for in in $inputs; do
    (( n++ ))
    outdir=${${o_out[-1]:-}#-o}; [[ -n $outdir ]] || outdir=${in:h}/FLAC
    mkdir -p -- "$outdir" || return 1
    out=$outdir/${in:t:r}.flac
    if [[ -e $out ]] && (( ! $#o_force )); then print -u2 -r -- "skip (exists, use -f): $out"; continue; fi
    title=${in:t:r}; title=${title#(Bonus |)[0-9]## }
    track=$n
    tags=( -metadata "title=$title" -metadata "track=$track/$total" )
    [[ -n ${o_artist[-1]:-} ]] && tags+=( -metadata "artist=${o_artist[-1]#-a}" -metadata "album_artist=${o_artist[-1]#-a}" )
    [[ -n ${o_album[-1]:-} ]] && tags+=( -metadata "album=${o_album[-1]#-A}" )
    [[ -n ${o_year[-1]:-} ]] && tags+=( -metadata "date=${o_year[-1]#-y}" )
    if ffmpeg -hide_banner -nostdin -loglevel error -y -downmix stereo -i "$in" -af "volume=${gain}dB" \
         -c:a flac -compression_level 8 -sample_fmt s32 $tags "$out" 2> >(grep -v 'incomplete frame' >&2); then
      print -r -- "ok: $out"; (( ok++ ))
    else
      print -u2 -r -- "FAILED: $in"; (( failed++ ))
    fi
  done
  print -r -- "done: $ok converted, $failed failed"
  (( failed == 0 ))
}

# Convert FLAC (or any lossless audio) to ALAC .m4a, keeping tags and cover art.
# -c makes CD-quality files (44.1 kHz, 16-bit, high-quality resampling with dither).
toalac() {
  emulate -L zsh
  setopt extended_glob no_unset

  local -a o_out o_force o_dry o_cd o_help
  zparseopts -D -E -F -- o:=o_out c=o_cd f=o_force n=o_dry h=o_help -help=o_help || return 2

  if (( $#o_help || $# == 0 )); then
    print -r -- "usage: toalac [-c] [-f] [-n] [-o DIR] FILE|DIR ...
  -o DIR  write .m4a files to DIR (default: ALAC/ or ALAC 44.1k-16bit/ next to the input folder)
  -c      CD quality: 44.1 kHz, 16-bit (default keeps the source rate and depth)
  -f      overwrite existing files
  -n      dry run"
    (( $#o_help )) && return 0 || return 2
  fi
  (( $+commands[ffmpeg] )) || { print -u2 "toalac: ffmpeg not found (brew install ffmpeg)"; return 127; }

  local -a inputs; local arg
  for arg in "$@"; do
    if [[ -d $arg ]]; then inputs+=( $arg/*.(#i)(flac|wav|aif|aiff)(N.) )
    elif [[ -f $arg ]]; then inputs+=( $arg )
    else print -u2 -r -- "toalac: not found: $arg"; fi
  done
  (( $#inputs )) || { print -u2 "toalac: no input files"; return 1; }

  local -a enc
  if (( $#o_cd )); then
    enc=( -af "aresample=44100:filter_size=64:phase_shift=10:cutoff=0.97:dither_method=triangular" -sample_fmt s16p )
  else
    enc=( -sample_fmt s32p )
  fi

  local in out outdir sub=ALAC ok=0 failed=0
  (( $#o_cd )) && sub="ALAC 44.1k-16bit"
  for in in $inputs; do
    outdir=${${o_out[-1]:-}#-o}; [[ -n $outdir ]] || outdir=${in:h:h}/$sub
    out=$outdir/${in:t:r}.m4a
    if (( $#o_dry )); then print -r -- "$in -> $out"; continue; fi
    mkdir -p -- "$outdir" || return 1
    if [[ -e $out ]] && (( ! $#o_force )); then print -u2 -r -- "skip (exists, use -f): $out"; continue; fi
    if ffmpeg -hide_banner -nostdin -loglevel error -y -i "$in" -map 0:a -map '0:v?' -c:v copy -disposition:v attached_pic \
         $enc -c:a alac -map_metadata 0 "$out"; then
      print -r -- "ok: $out"; (( ok++ ))
    else
      print -u2 -r -- "FAILED: $in"; (( failed++ ))
    fi
  done
  (( $#o_dry )) || print -r -- "done: $ok converted, $failed failed"
  (( failed == 0 ))
}
