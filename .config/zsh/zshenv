# Core paths. Keep Homebrew ahead of /usr/bin for interactive shells and tools.
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"

# Volta home dir
export VOLTA_HOME="$HOME/.volta"
export PATH="$VOLTA_HOME/bin:$PATH"

# Main configs dir
export XDG_CONFIG_HOME="$HOME/.config"

# Set editor
export EDITOR="nvim"

# Starship config file
export STARSHIP_CONFIG="$XDG_CONFIG_HOME/starship/starship.toml"

# Homebrew Env Hints Off
export HOMEBREW_NO_ENV_HINTS=true

# NextJS Telemetry Opt Out
export NEXT_TELEMETRY_DISABLED=1

# Homebrew Emojis Off
export HOMEBREW_NO_EMOJI=1

# Java flags for compilers
export CPPFLAGS="-I/opt/homebrew/opt/openjdk/include"

# Chrome binary for dev testing
export CHROME_BIN="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"

# Bat code hightlight theme
export BAT_THEME="Catppuccin Mocha"

# XQuartz Fallback
export DYLD_FALLBACK_LIBRARY_PATH="${DYLD_FALLBACK_LIBRARY_PATH}:/usr/lib:/usr/X11/lib"

