# Personal GitHub (existing default key)
Host github.com
  HostName ssh.github.com
  Port 443
  User git
  IdentityFile ~/.ssh/macbook_air/macbook_air
  IdentitiesOnly yes
  AddKeysToAgent yes
  UseKeychain yes

# GTEC (GitLab/Gitea-style server on your corporate domain)
Host gtec
  HostName git.gtec.com.mx
  User git
  IdentityFile ~/.ssh/macbook_air/macbook_air_gtec
  IdentitiesOnly yes
  AddKeysToAgent yes
  UseKeychain yes

# GNP on gitlab.com (use a host ALIAS so it picks this key)
Host gnp-gitlab
  HostName gitlab.com
  User git
  IdentityFile ~/.ssh/macbook_air/macbook_air_gnp
  IdentitiesOnly yes
  AddKeysToAgent yes
  UseKeychain yes
  
